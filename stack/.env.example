# Copy to .env (never commit .env). Every value below is a placeholder.

# --- Telegram bot (create one with @BotFather, then send it a message to find your chat id)
TG_TOKEN=123456:replace-with-your-bot-token
TG_CHAT=123456789

# --- Server details used in links
HL_HOSTNAME=localhost                      # the server's name on your network
HOMEPAGE_VAR_HOSTNAME=localhost            # same name, for the Homepage dashboard
HL_TIMEZONE=UTC                            # IANA zone, same as config.yaml
HL_ALLOWED_HOSTS=localhost:3080,127.0.0.1:3080   # names you open Homepage with, comma separated

# --- Passwords and keys for the other apps (make up long random ones)
GF_SECURITY_ADMIN_PASSWORD=change-me
HOMEPAGE_VAR_GRAFANA_PASS=change-me        # same as the Grafana admin password
HOMEPAGE_VAR_ADGUARD_PASS=change-me
HOMEPAGE_VAR_WATCHTOWER_TOKEN=change-me
WEBUI_SECRET_KEY=change-me

# --- Optional
# BOT_MODEL=qwen3.5:4b                     # overrides models.chat in config.yaml
# GMAIL_USER=you@example.com               # for the email feature (app password goes in the secrets folder)
# HL_CHAT_MODEL=qwen3.5:4b                 # default model in Open WebUI
# HL_SECRETS_DIR=./secrets                 # folder holding gmail / calendar / Anthropic key files

# --- Where things live (install.sh sets these; the defaults match a plain Linux server)
# HL_DATA_DIR=/var/lib/homelab-bot         # the assistant's data (journal, notes, budget)
# HL_STATS_DIR=/var/lib/homelab-stats      # machine stats written by the host layer
# HL_BIND=127.0.0.1                       # who can reach the dashboard: 127.0.0.1 = this machine only. install.sh --lan opens it to your network (needs a PIN)
# HL_PORT=3095                             # the dashboard's port on this machine
