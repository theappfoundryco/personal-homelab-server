{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "schedule": ["before 6am on monday"],
  "timezone": "UTC",
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Major versions can migrate data in ways that cannot be undone, so they wait for a person to tick them in the dashboard issue.",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Small updates to the monitoring and tooling images come together in one pull request.",
      "matchManagers": ["docker-compose"],
      "matchUpdateTypes": ["minor", "patch"],
      "matchPackageNames": ["prom/prometheus", "prom/node-exporter", "ghcr.io/google/cadvisor", "grafana/grafana", "amir20/dozzle", "louislam/uptime-kuma"],
      "groupName": "monitoring images"
    },
    {
      "description": "SearXNG tags are dates plus a commit, not versions; use its own versioning.",
      "matchPackageNames": ["searxng/searxng"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-(?<build>[0-9a-f]+)$"
    }
  ]
}
