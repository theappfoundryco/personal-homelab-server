#!/usr/bin/env python3
"""Adds the host timers (backups, security updates) to the bot's run log, so the Night log shows them next to the AI jobs.
Every 10 minutes: each unit's last finished run (start, end, result), once per run."""
import json, os, subprocess, time
LOG, SEEN = "/var/lib/homelab-bot/runs.jsonl", "/var/lib/homelab-runlog/seen.json"
UNITS = {"homelab-backup": ("Nightly backup", "03:30"), "homelab-usb-backup": ("USB backup", "04:00, 10:00, 16:00, 22:00"),
         "apt-daily-upgrade": ("Security updates", "around 6 AM")}
os.makedirs(os.path.dirname(SEEN), exist_ok=True)
try:
    seen = json.load(open(SEEN))
except Exception:
    seen = {}
for u, (name, sched) in UNITS.items():
    out = subprocess.run(["systemctl", "show", u + ".service", "-p", "ExecMainStartTimestamp", "-p", "ExecMainExitTimestamp",
                          "-p", "Result", "-p", "ActiveState"], capture_output=True, text=True).stdout
    p = dict(l.split("=", 1) for l in out.splitlines() if "=" in l)
    unix = lambda v: str(time.mktime(time.strptime(" ".join(v.split()[1:3]), "%Y-%m-%d %H:%M:%S"))) if v and len(v.split()) >= 3 else ""  # server local time
    st, en = unix(p.get("ExecMainStartTimestamp", "")), unix(p.get("ExecMainExitTimestamp", ""))
    if not st or not en or p.get("ActiveState") == "activating" or seen.get(u) == st or float(en) < float(st):
        continue
    ok = p.get("Result") == "success"
    with open(LOG, "a") as f:
        f.write(json.dumps({"t": "job", "id": f"host-{u}-{int(float(st))}", "parent": None, "job": name, "sched": sched, "start": float(st),
                            "end": float(en), "secs": round(float(en) - float(st), 1), "status": "ok" if ok else "failed",
                            "err": None if ok else "result: " + p.get("Result", "?"), "host": True}) + "\n")
    seen[u] = st
json.dump(seen, open(SEEN, "w"))
